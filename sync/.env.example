DATABASE_URL=postgresql://postbox:password@localhost:5432/postbox_sync
PORT=8080
ACCOUNTS_FILE=./accounts.json
# The service's master credential. Required on every /api route except
# GET /api/health and POST /api/session, and accepted two ways:
#   - Authorization: Bearer $API_TOKEN  (scripts, curl, deploy checks)
#   - an HttpOnly session cookie the browser gets from POST /api/session,
#     which is an HMAC keyed off a value derived from this token and NEVER
#     contains the token itself (see src/api/session.ts).
# Rotating this value therefore signs every browser out as well as
# invalidating every bearer script — that is the only bulk revocation
# there is, and it is deliberate: there is no session store to purge.
# POST /api/session is rate limited to 10 failed attempts per 60 seconds
# (in-memory, global, cleared by a restart); no other route is limited.
# The window is short because a longer one buys no security against a
# 256-bit token and only lengthens how long an attacker can keep you
# locked out. See sync/src/api/rate-limit.ts before changing either number.
# The service refuses to start without one of at least 32 characters (see
# requireApiToken in src/api/server.ts) rather than silently serving four
# real mailboxes unauthenticated. Generate one with:
#   openssl rand -hex 32
API_TOKEN=replace-me-with-openssl-rand-hex-32

# Base URL and bearer read-token for the tracking service (separate
# deployment: Vercel Edge + Neon Postgres, see tracking/). Three jobs, one
# pair of values — there is deliberately no separate PIXEL_BASE:
#   - GET /api/opens (src/api/opens.ts) proxies open events, so the
#     browser client holds one origin and one token, not two;
#   - POST /api/send (src/api/send.ts) mints one tracking token per
#     recipient via the tracking service's own POST /api/tokens, using the
#     SAME bearer token (it guards both reading and minting);
#   - and the pixel URL in every sent message is built from this base:
#     {TRACKING_BASE_URL}/o/{token}.png. A trailing slash is fine.
# Optional for sync (email sync is the primary job): if either is missing
# the service still starts, logs a warning at startup, and /api/opens
# reports { available: false }. Sending, however, FAILS CLOSED — POST
# /api/send answers 502 {"error":"tracking unavailable"} rather than
# quietly sending untracked mail, and does the same whenever the tracking
# service is unreachable or refuses to mint. There is no untracked
# fallback by design: a send that claims to be tracked and is not would be
# this service lying about what it did.
#
# POST /api/send additionally carries a global cap of 30 sends per hour
# (in-memory, cleared by a restart, counting EVERY attempt including
# rejected ones). It is a runaway-script brake, not a security control —
# the route is authenticated. See SEND_RATE_LIMIT_* in src/api/send.ts.
TRACKING_BASE_URL=https://replace-me.vercel.app
TRACKING_READ_TOKEN=replace-me-with-the-tracking-services-read-token

# Web Push (RFC 8292 VAPID). Generate ONE pair, once, and keep it:
#   npx web-push generate-vapid-keys
# The public key is handed to the browser by GET /api/push/key and is
# public by construction — it travels to Apple's/Google's push service on
# every subscribe. The PRIVATE key signs the JWT that authorises each push;
# treat it exactly like API_TOKEN, and never print, log or paste it.
# Rotating the pair invalidates every stored subscription: each browser has
# to be toggled off and on again.
#
# Optional, and deliberately so: if either key is missing the service still
# STARTS (email sync is the primary job), logs one loud warning, and
# GET /api/push/key reports { available: false } while
# POST /api/push/subscribe answers 503. Same degradation rule as TRACKING_*
# above, and deliberately unlike API_TOKEN, which is fail-closed.
VAPID_PUBLIC_KEY=replace-me-with-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=replace-me-with-npx-web-push-generate-vapid-keys

# The JWT `sub` claim (RFC 8292 §2.1): a mailto: or https: URI the push
# service operator could use to reach whoever runs this deployment. An
# https: URL is used rather than a mailto: so no personal address is
# embedded in every JWT sent to Apple and Google. Optional — defaults to
# the deployment's own hostname. A value that is neither mailto: nor https:
# disables push rather than producing a JWT every push service rejects.
VAPID_SUBJECT=https://postbox-valen.duckdns.org
