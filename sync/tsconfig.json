{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The service runs source directly via `node --experimental-strip-types`
    // (see package.json "dev"/"start") rather than through a tsc build step,
    // and that runtime resolves relative imports only when the specifier
    // carries the real `.ts` extension. This flag lets cross-module value
    // imports under src/ (first needed by src/imap/fetch.ts) write that
    // extension without tsc rejecting it as invalid syntax.
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node"]
  },
  // "types" holds the hand-written ambient declaration for `web-push`,
  // which ships none of its own. It lives OUTSIDE src/ deliberately:
  // scripts/check-runtime.ts imports every src/**/*.ts under
  // --experimental-strip-types, and a declaration-only file is not a
  // module that runtime should be asked to load.
  "include": ["src", "tests", "types"]
}
