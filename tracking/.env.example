DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
IP_HASH_SALT=replace-with-32-random-bytes-hex
PIXEL_BASE=https://your-project.vercel.app
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Bearer token for GET /api/opens AND POST /api/tokens (Plan 4 Task 1 added
# the latter; the name was kept rather than renamed, since both routes
# guard the same secret the same way). Must be at least 32 characters or
# the route fails closed with 503 and serves nothing. Generate with:
#   openssl rand -hex 32
READ_API_TOKEN=replace-with-32-random-bytes-hex
