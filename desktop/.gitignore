# Rust build artifacts. Hundreds of MB — never committed.
target/

# The Tauri CLI binary, installed by `npm install`. package-lock.json IS
# committed so the CLI version is pinned.
node_modules/

# Regenerated by tauri-build on every compile. These are editor JSON
# schemas for tauri.conf.json's `$schema` reference, not source; Tauri's own
# project template ignores them for the same reason.
gen/schemas/
