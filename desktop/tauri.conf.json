{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Postbox",
  "version": "0.1.0",
  "identifier": "org.duckdns.postbox-valen.desktop",
  "build": {
    "frontendDist": "https://postbox-valen.duckdns.org",
    "devUrl": "https://postbox-valen.duckdns.org"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    },
    "macOSPrivateApi": false
